# Copy to .env.production on the server. Never commit this file with secrets.
YAMREG_SIGNING_KEY=ed25519:replace-with-a-base64-32-byte-seed
YAMREG_GITHUB_CLIENT_ID=replace-with-client-id
YAMREG_GITHUB_CLIENT_SECRET=replace-with-client-secret
YAMREG_GITHUB_REDIRECT_URL=https://repo.yse.wtf/api/v2/auth/github/callback
YAMREG_ADMIN_GITHUB_LOGINS=octocat
RUST_LOG=info
YAMREG_COOKIE_SECURE=true

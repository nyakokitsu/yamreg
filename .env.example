# Local data directory (optional)
YAMREG_ROOT=./yamreg-data

# Base64 32-byte Ed25519 seed; generate with: openssl rand -base64 32
YAMREG_SIGNING_KEY=ed25519:replace-with-a-secret-32-byte-base64-seed

# GitHub OAuth App settings. Callback must exactly match this URL.
YAMREG_GITHUB_CLIENT_ID=replace-with-client-id
YAMREG_GITHUB_CLIENT_SECRET=replace-with-client-secret
YAMREG_GITHUB_REDIRECT_URL=https://repo.example.com/api/v2/auth/github/callback
RUST_LOG=info
# Set false only for plain-http localhost development.
YAMREG_COOKIE_SECURE=true

# Comma-separated GitHub logins allowed to access /moderation.
YAMREG_ADMIN_GITHUB_LOGINS=octocat
